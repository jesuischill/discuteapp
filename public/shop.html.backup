<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛍️ Boutique - DiscuteApp</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="shop-container">
    <div class="shop-header">
      <div>
        <h1>🛍️ Boutique</h1>
        <p>Achète des objets pour personnaliser ton profil.</p>
      </div>
      <div class="shop-gems">💎 <span id="gems">0</span></div>
    </div>

    <p id="shopMessage"></p>

    <h2>Objets disponibles</h2>
    <div id="shopItems" class="shop-grid"></div>

    <h2>🎒 Mon inventaire</h2>
    
  </main>

  <script>
    let currentUser = null;

    async function api(url, options = {}) {
      const response = await fetch(url, {
        ...options,
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          ...(options.headers || {})
        }
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Erreur.");
      }

      return data;
    }

    function message(text, error = false) {
      const element = document.getElementById("shopMessage");
      element.textContent = text;
      element.className = error ? "shop-error" : "shop-success";
    }

    async function loadUser() {
      const data = await api("/api/me");
      currentUser = data.user;
      document.getElementById("gems").textContent = currentUser.gems;
    }

    async function loadShop() {
      const data = await api("/api/shop/items");
      const container = document.getElementById("shopItems");
      container.innerHTML = "";

      data.items.forEach(item => {
        const card = document.createElement("article");
        card.className = "shop-card";

        const icon = document.createElement("div");
        icon.className = "shop-icon";
        icon.textContent = item.item_data.badge || item.item_data.title || "🎁";

        const title = document.createElement("h3");
        title.textContent = item.name;

        const description = document.createElement("p");
        description.textContent = item.description;

        const price = document.createElement("strong");
        price.textContent = "💎 " + item.price;

        const button = document.createElement("button");
        button.textContent = "Acheter";
        button.onclick = () => buyItem(item.id);

        card.append(icon, title, description, price, button);
        container.appendChild(card);
      });
    }

    async function {
      const data = await api("/api/shop/inventory");
      const container = document.getElementById("inventory");
      container.innerHTML = "";

      if (!data.items.length) {
        container.innerHTML = "<p>Ton inventaire est vide.</p>";
        return;
      }

      data.items.forEach(item => {
        const card = document.createElement("article");
        card.className = "shop-card";

        const icon = document.createElement("div");
        icon.className = "shop-icon";
        icon.textContent = item.item_data.badge || item.item_data.title || "🎁";

        const title = document.createElement("h3");
        title.textContent = item.name;

        const button = document.createElement("button");
        button.textContent = item.equipped ? "Déséquiper" : "Équiper";

        button.onclick = async () => {
          try {
            await api(
              item.equipped ? "/api/shop/unequip" : "/api/shop/equip",
              {
                method: "POST",
                body: JSON.stringify({ itemId: item.id })
              }
            );

            message(item.equipped ? "Objet déséquipé." : "Objet équipé.");
            await
          } catch (error) {
            message(error.message, true);
          }
        };

        card.append(icon, title, button);
        container.appendChild(card);
      });
    }

    async function buyItem(itemId) {
      try {
        const data = await api("/api/shop/buy", {
          method: "POST",
          body: JSON.stringify({ itemId })
        });

        currentUser = data.user;
        document.getElementById("gems").textContent = currentUser.gems;

        message("Objet acheté avec succès !");
        await
        await loadShop();
      } catch (error) {
        message(error.message, true);
      }
    }

    async function start() {
      try {
        await loadUser();
        await loadShop();
        await
      } catch {
        document.body.innerHTML = `
          <main class="shop-container">
            <h1>🔒 Connexion requise</h1>
            <p>Connecte-toi sur DiscuteApp avant d'ouvrir la boutique.</p>
            <button onclick="window.close()">Fermer</button>
          </main>
        `;
      }
    }

    start();
  </script>
</body>
</html>
