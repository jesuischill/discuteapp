async function loadAdminUsers() {
  try {
    const users = await api("/api/admin/users");
    const container = document.getElementById("adminUsers");

    if (!container) return;

    container.innerHTML = "";

    users.forEach(user => {
      const card = document.createElement("div");
      card.className = "card";

      const title = document.createElement("strong");
      title.textContent =
        `${user.username} — ${user.role}` +
        (user.banned ? " 🚫 BANNI" : "");

      card.appendChild(title);

      const info = document.createElement("p");
      info.textContent =
        `Créé le : ${user.created_at || "inconnu"}`;
      card.appendChild(info);

      if (user.role !== "owner") {
        const ban = document.createElement("button");
        ban.textContent = user.banned ? "✅ Débannir" : "🚫 Bannir";
        ban.className = user.banned ? "success" : "danger";
        ban.onclick = () =>
          user.banned ? unbanUser(user.id) : banUser(user.id);
        card.appendChild(ban);
      }

      if (me.role === "owner" && user.role !== "owner") {
        const role = document.createElement("button");
        role.textContent =
          user.role === "admin"
            ? "➖ Retirer Admin"
            : "➕ Donner Admin";

        role.onclick = () =>
          changeRole(
            user.id,
            user.role === "admin" ? "user" : "admin"
          );

        card.appendChild(role);
      }

      if (user.role !== "owner" && user.username !== "chilladmin") {
        const del = document.createElement("button");
        del.textContent = "🗑️ Supprimer définitivement";
        del.className = "danger";

        del.onclick = async () => {
          if (!confirm(
            `Supprimer définitivement ${user.username} ?\n\nToutes ses données liées seront supprimées.`
          )) return;

          try {
            await api(`/api/admin/users/${user.id}/delete-permanently`, {
              method: "POST"
            });

            alert("Compte supprimé définitivement.");
            await loadAdminUsers();
          } catch (error) {
            alert(error.message);
          }
        };

        card.appendChild(del);
      }

      container.appendChild(card);
    });
  } catch (error) {
    alert(error.message);
  }
}

