<style>

/* ===== ÉCRAN D'AUTHENTIFICATION ===== */

body.auth-screen {
  overflow: hidden;
}

body.auth-screen #mainAccountPanel {
  position: fixed !important;
  inset: 0 !important;
  z-index: 99999 !important;
  width: 100% !important;
  min-height: 100vh !important;
  margin: 0 !important;
  padding: 30px 20px !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background:
    linear-gradient(rgba(3,10,18,.48), rgba(3,10,18,.58)),
    radial-gradient(ellipse at 50% 100%, rgba(255,166,80,.30), transparent 45%),
    linear-gradient(180deg, #172c4a 0%, #315d78 45%, #d88965 100%);
}

body.auth-screen #auth {
  width: min(460px, 92vw);
  margin: 0 !important;
  background: rgba(8,12,20,.95);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0,0,0,.50);
}

body.auth-screen #account,
body.auth-screen .app-controls-hidden {
  visibility: hidden !important;
}

/* ===== FIN ÉCRAN D'AUTHENTIFICATION ===== */

/* ===== STYLE SIMPLE ===== */

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  color: #fff;
  background:
    radial-gradient(ellipse at 50% 100%, rgba(255,166,80,.28), transparent 42%),
    radial-gradient(ellipse at 15% 70%, rgba(30,140,170,.24), transparent 38%),
    radial-gradient(ellipse at 85% 65%, rgba(20,110,145,.22), transparent 38%),
    linear-gradient(180deg, #172c4a 0%, #315d78 38%, #d88965 72%, #182f38 100%);
  position: relative;
}

body::before {
  content: "";
  position: fixed;
  left: -10%;
  bottom: 5%;
  width: 120%;
  height: 180px;
  background:
    radial-gradient(ellipse at 50% 100%,
      rgba(100,210,220,.20) 0%,
      rgba(30,120,150,.12) 45%,
      transparent 70%);
  border-radius: 50%;
  transform: rotate(-2deg);
  pointer-events: none;
  z-index: -1;
}

body::after {
  content: "";
  position: fixed;
  left: -10%;
  bottom: -5%;
  width: 120%;
  height: 220px;
  background:
    radial-gradient(ellipse at 50% 0%,
      rgba(15,70,75,.30) 0%,
      transparent 68%);
  border-radius: 50%;
  transform: rotate(2deg);
  pointer-events: none;
  z-index: -1;
}

body::before,
body::after {
  content: "";
  position: fixed;
  left: -10%;
  width: 120%;
  height: 180px;
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
}

body::before {
  bottom: 8%;
  background: rgba(59,130,246,.07);
  transform: rotate(-3deg);
}

body::after {
  bottom: -2%;
  background: rgba(124,58,237,.06);
  transform: rotate(4deg);
}

.account-panel.login-mode {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 30px 20px;
  box-sizing: border-box;
}

.login-home-title {
  display: none;
}

#auth {
  width: min(460px, 92vw);
  padding: 28px;
  box-sizing: border-box;
  background: #111;
  border: 1px solid #333;
  border-radius: 12px;
}

#auth input {
  width: 100%;
  box-sizing: border-box;
  margin: 7px 0;
  padding: 14px 16px;
  border-radius: 8px;
  border: 1px solid #333;
  background: #000;
  color: white;
  outline: none;
  font-size: 16px;
}

#auth .buttons {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
  flex-wrap: nowrap;
}

#auth .buttons button {
  border: 1px solid #444;
  border-radius: 8px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 700;
  color: white;
  background: #222;
}

.account-panel.app-mode {
  min-height: auto;
  display: block;
  padding: initial;
}

.app-controls-hidden {
  display: none !important;
}

/* Boutons principaux : alignés à droite */
.account-panel.app-mode {
  text-align: center;
  width: 250px;
  box-sizing: border-box;
}

.account-panel.app-mode > button {
  display: block;
  width: 220px !important;
  margin: 8px auto !important;
}

.account-panel.app-mode #adminButton {
  display: block;
  width: 220px !important;
  margin: 8px auto !important;
}
</style>

