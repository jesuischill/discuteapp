<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administration - DiscuteApp</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    body {
      min-height: 100vh;
      margin: 0;
      padding: 30px;
      background: #090d18;
      color: white;
      font-family: Arial, sans-serif;
    }

    .admin-wrapper {
      max-width: 1200px;
      margin: auto;
    }

    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 24px;
      margin-bottom: 25px;
      border: 1px solid #334155;
      border-radius: 18px;
      background: linear-gradient(135deg, #111827, #172554);
    }

    .admin-header h1 {
      margin: 0 0 8px;
      color: #facc15;
    }

    .admin-header p {
      margin: 0;
      color: #cbd5e1;
    }

    .admin-close {
      padding: 12px 18px;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      background: #334155;
      color: white;
      font-weight: bold;
    }

    .admin-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .admin-card {
      padding: 22px;
      border: 1px solid #334155;
      border-radius: 16px;
      background: #111827;
    }

    .admin-card h2 {
      margin-top: 0;
      color: #60a5fa;
    }

    .admin-card p {
      color: #94a3b8;
      line-height: 1.5;
    }

    .admin-status {
      margin-top: 25px;
      padding: 16px;
      border-radius: 12px;
      background: #172033;
      color: #cbd5e1;
    }
  </style>
</head>

<body>
  <main class="admin-wrapper">
    <header class="admin-header">
      <div>
        <h1>🛡️ Administration DiscuteApp</h1>
        <p>Panneau réservé au compte chilladmin</p>
      </div>

      <button class="admin-close" onclick="window.close()">
        Fermer
      </button>
    </header>

    <section class="admin-grid">
      <article class="admin-card">
        <h2>👥 Gestion des comptes</h2>
        <p>Rechercher, bannir, débannir et gérer les utilisateurs.</p>
      </article>

      <article class="admin-card">
        <h2>💬 Chat public</h2>
        <p>Envoyer des annonces et gérer les messages publics.</p>
      </article>

      <article class="admin-card">
        <h2>🛍️ Boutique</h2>
        <p>Gérer les gemmes, les objets et les réductions.</p>
      </article>

      <article class="admin-card">
        <h2>🤖 DiscuteBot</h2>
        <p>Modifier l’humeur et la façon de parler du bot.</p>
      </article>

      <article class="admin-card">
        <h2>🧠 Quiz</h2>
        <p>Créer des quiz, modifier les récompenses et publier les questions.</p>
      </article>
    </section>

    <div class="admin-status">
      Vérification de l’accès administrateur…
    </div>
  </main>

  <script>
    async function verifyAdmin() {
      try {
        const response = await fetch("/api/me", {
          credentials: "include"
        });

        if (!response.ok) {
          window.location.href = "/";
          return;
        }

        const data = await response.json();
        const user = data.user;

        if (!user || user.username !== "chilladmin") {
          document.body.innerHTML = `
            <div style="text-align:center;margin-top:100px;color:white">
              <h1>⛔ Accès refusé</h1>
              <p>Ce panneau est réservé à chilladmin.</p>
              <button onclick="location.href='/'">Retour</button>
            </div>
          `;
          return;
        }

        document.querySelector(".admin-status").textContent =
          "✅ Accès confirmé pour chilladmin.";
      } catch (error) {
        window.location.href = "/";
      }
    }

    verifyAdmin();
  </script>
</body>
</html>
