    }

    .question {
      background: #202943;
      padding: 22px;
      border-radius: 14px;
      margin-top: 20px;
    }

    .answers {
      display: grid;
      gap: 12px;
      margin-top: 20px;
    }

    .answer {
      background: #334155;
      color: white;
      border: 1px solid #64748b;
      border-radius: 10px;
      padding: 15px;
      cursor: pointer;
      text-align: left;
    }

    .answer:hover {
      background: #4f46e5;
    }

    .answer.correct {
      background: #15803d;
    }

    .answer.wrong {
      background: #b91c1c;
    }

    .hidden {
      display: none !important;
    }

    #result {
      text-align: center;
      margin-top: 25px;
      font-size: 20px;
    }
  </style>

<style>
