<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎮 Quiz - DiscuteApp</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      min-height: 100vh;
      padding: 30px;
    }

    #quizDisabledScreen {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
    }

    #quizDisabledScreen .maintenance-card {
      max-width: 520px;
      padding: 35px;
      border: 1px solid #334155;
      border-radius: 18px;
      background: #111827;
      box-shadow: 0 0 30px rgba(0,0,0,.25);
    }

    #quizDisabledScreen h2 {
      color: #facc15;
      margin-bottom: 15px;
    }

    #quizDisabledScreen p {
      color: #cbd5e1;
      line-height: 1.6;
    }

    .quiz-container {
      max-width: 850px;
      margin: auto;
      background: #151b2e;
      border: 1px solid #334155;
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 0 30px #0005;
    }

    h1, h2 {
      text-align: center;
    }

    .back-button,
    .quiz-button {
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      cursor: pointer;
      font-weight: bold;
      margin: 6px;
    }

    .back-button {
      background: #334155;
      color: white;
    }

    .quiz-button {
      background: #6366f1;
      color: white;
    }

    .themes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 25px;
    }

    .theme {
      background: #202943;
      border: 1px solid #475569;
      color: white;
      border-radius: 12px;
      padding: 18px;
      cursor: pointer;
      text-align: center;
