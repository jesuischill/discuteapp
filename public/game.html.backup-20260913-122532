    }

    .difficulty button {
      padding: 15px 25px;
      border: 0;
      border-radius: 12px;
      color: white;
      cursor: pointer;
      font-weight: bold;
    }

    .easy {
      background: #16a34a;
    }

    .hard {
      background: #dc2626;
    }

